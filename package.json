{
    "$schema": "https://raw.githubusercontent.com/qwqnt-community/types/main/plugin.schema.json",
    "name": "qwqnt-poke",
    "type": "module",
    "version": "1.0.0",
    "description": "双击头像戳一戳，支持 Native 发包与 HTTP API",
    "scripts": {
        "build": "rolldown -c rolldown.config.ts",
        "watch": "rolldown -c rolldown.config.ts -w",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "packageManager": "pnpm@10.30.3",
    "devDependencies": {
        "@qwqnt/types": "github:qwqnt-community/types",
        "@types/node": "^25.3.3",
        "@vitejs/plugin-vue": "^6.0.3",
        "autoprefixer": "^10.4.23",
        "postcss": "^8.5.6",
        "rolldown": "1.0.0-rc.7",
        "rollup-plugin-postcss": "^4.0.2",
        "tailwindcss": "^3.4.19",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "qwqnt": {
        "name": "戳一戳",
        "inject": {
            "main": "./dist/main/index.js",
            "preload": "./dist/preload/index.js",
            "renderer": "./dist/renderer/index.js"
        },
        "dependencies": {
            "qwqnt-hako": "^1.0.0",
            "qwqnt-ipc-interceptor": "^1.2.0"
        }
    },
    "dependencies": {
        "@protobuf-ts/runtime": "^2.11.1",
        "@saltify/typeproto": "^0.3.0",
        "electron": "^40.7.0",
        "vue": "^3.5.29"
    }
}
